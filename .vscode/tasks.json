{
  // Cmd+Shift+P -> "Tasks: Run Task". The default build task (Cmd+Shift+B) is the
  // walkthrough, since that is the one you want most often.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Walkthrough: CSV -> models -> graphs",
      "type": "shell",
      "command": "uv run python examples/walkthrough.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Report: all six figures",
      "type": "shell",
      "command": "uv run demandml report",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Report: quick",
      "type": "shell",
      "command": "uv run demandml report --quick --sku-limit 120",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "uv run pytest tests/ -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Setup: sync the environment",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
