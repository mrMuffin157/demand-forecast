# Data: generated by scripts/make_sample_data.py, or your own extract. Never committed.
data/*
!data/.gitkeep

# Generated outputs: backtest results, cached predictions, figures, forecasts, order
# plans and the Markdown reports the scripts write. All reproducible from the code.
dev/results*/
dev/*figures*/
dev/forecasts/
dev/orders/
dev/tuned_params/
dev/*.md
dev/dashboard*.html
model_lab/results/
model_lab/figures/
model_lab/*.md
experiments/
reports/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Credentials never belong in the repo.
.env
*.env
*.pem
*.key
*credentials*.json
*serviceaccount*.json
